# ---- База данных (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/challenges

# ---- Сервер ----
PORT=3000
# Публичный HTTPS-адрес сервера. Mini App откроется по $PUBLIC_URL/app/, админка — $PUBLIC_URL/admin/
PUBLIC_URL=https://vitalprobiznes.ru

# ---- Telegram-бот ----
# Токен от @BotFather. Не присылай его в чат, только в этот файл/переменные хостинга.
BOT_TOKEN=
# Имя бота без @ (для ссылок «поделиться» и QR на сертификате)
BOT_USERNAME=sugar_free_Bot
# polling — проще всего; webhook — если хостинг засыпает без входящих запросов
BOT_MODE=polling
# Для BOT_MODE=webhook: любая случайная строка
BOT_WEBHOOK_SECRET=

# ---- Tribute ----
# API-ключ из Tribute (Настройки → API). Им подписываются вебхуки.
# Адрес вебхука для Tribute: $PUBLIC_URL/webhooks/tribute
TRIBUTE_API_KEY=

# ---- Админка ----
ADMIN_PASSWORD=

# ---- Прочее ----
# Таймзона по умолчанию (пока участник не открыл Mini App)
DEFAULT_TIMEZONE=Europe/Moscow
# Папка для фото-доказательств и картинок
UPLOADS_DIR=./uploads
# Вход в Mini App из обычного браузера: /app/?dev=<telegramId>. Только для локальной разработки!
DEV_AUTH=0
